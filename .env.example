# CLOVA Studio credentials will be added after the current API guide is confirmed.
CLOVA_API_KEY=
CLOVA_API_GATEWAY_KEY=
CLOVA_REQUEST_ID=
CLOVA_API_HOST=clovastudio.stream.ntruss.com

# Keep this false until the latest CLOVA API endpoint and payload are configured.
CLOVA_ENABLED=false

# Select the RAG implementation used by the shared app.py entry point.
# classic = rag/, langgraph = langgraph_app/
RAG_BACKEND=classic

# Required for indexing and production retrieval.
POSTGRES_DSN=postgresql://user:password@host:5432/rag
LOCAL_VECTOR_INDEX=test_data/disclosure_clova_local.json
RAG_SOURCE_ROOT=
RAG_RETRIEVAL_TOP_K=20
RAG_RERANK_TOP_K=10
RAG_MAX_TOOL_ROUNDS=2
