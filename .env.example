# ─────────────────────────────────────────────────────────────────────────
# CLOVA 인증
# ─────────────────────────────────────────────────────────────────────────
# 배포 환경에서만 주입한다. 실제 키는 이 파일·Git·로그에 넣지 않는다.
CLOVA_API_KEY=
CLOVA_API_HOST=clovastudio.stream.ntruss.com
# 임베딩 adapter만 사용하는 대체 키 이름. 답변 생성에는 CLOVA_API_KEY가 필요하다.
# CLOVASTUDIO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 경로 (모두 config.py가 관리. 상대경로는 CWD가 아니라 프로젝트 루트 기준)
# ─────────────────────────────────────────────────────────────────────────
# Stage1 corpus: universe.csv와 manifest.jsonl이 있는 디렉터리.
# 비워두면 Stage1이 파일시스템에서 자동 탐색한다.
# CORPUS_DIR=data/corpus

# ─────────────────────────────────────────────────────────────────────────
# Stage2 모드: fixture | local | container  (코드 기본값 fixture, 서버 예시는 local)
#   fixture   - CLOVA 사전계산 임베딩 JSON. DB 서비스 불필요 (테스트/오프라인).
#   local     - 로컬 SQLite(metadata 필터) + 로컬 Chroma persist 디렉터리(vector).
#   container - Dockerized Postgres + Chroma 서버. RDB_URL·CHROMA_HOST 둘 다 필수.
# ─────────────────────────────────────────────────────────────────────────
STAGE2_MODE=local

# fixture 모드(CI·오프라인 테스트에서만 STAGE2_MODE=fixture로 전환)
STAGE2_FIXTURE_PATH=legacy/test_data/disclosure_clova_local.json

# local 모드 — 제공된 read-only 인덱스
STAGE2_INDEX_PATH=data/team-feature2-local-db/local_db/chunk_index.db
STAGE2_CHROMA_PATH=data/team-feature2-local-db/local_db/chunk_index_chroma
STAGE2_CHROMA_COLLECTION=chunk_vectors
STAGE2_SQL_TABLE=chunk_index
STAGE2_EMBEDDING=e5-instruct
STAGE2_ALLOW_PARTIAL_INDEX=true

# container 모드
# STAGE2_RDB_URL=postgresql+psycopg://user:password@host:5432/database
# STAGE2_CHROMA_HOST=chroma
# STAGE2_CHROMA_PORT=8000

# local·container 공통: 벡터 컬렉션 이름 (인덱스 빌드 시점과 반드시 일치)
STAGE2_CHROMA_COLLECTION=chunk_vectors

# ─────────────────────────────────────────────────────────────────────────
# CLOVA 답변 생성·semantic validation
# ─────────────────────────────────────────────────────────────────────────
CLOVA_LLM_ENABLED=true
CLOVA_CHAT_MODEL=HCX-DASH-002

# CLOVA 호출·rate limit
CLOVA_EMBEDDING_TIMEOUT=30
CLOVA_CHAT_TIMEOUT=60
CLOVA_CHAT_MAX_RETRIES=1
CLOVA_CHAT_MIN_INTERVAL=0.2
CLOVA_RATE_LIMIT_MAX_WAIT=60
DIS164_QUERY_PLAN_V1=true
CLOVA_ANSWER_MAX_TOKENS=512
CLOVA_SEMANTIC_MAX_TOKENS=256
