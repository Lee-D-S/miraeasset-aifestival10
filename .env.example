# ─────────────────────────────────────────────────────────────────────────
# CLOVA 인증
# ─────────────────────────────────────────────────────────────────────────
# 배포 환경에서만 주입한다. 실제 키는 이 파일·Git·로그에 넣지 않는다.
CLOVA_API_KEY=
CLOVA_API_HOST=clovastudio.stream.ntruss.com
# CLOVA API의 대체 인증 키 이름. Retriever E5 query embedding에는 사용하지 않는다.
# CLOVASTUDIO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 경로 (모두 config.py가 관리. 상대경로는 CWD가 아니라 프로젝트 루트 기준)
# ─────────────────────────────────────────────────────────────────────────
# Interpreter corpus: universe.csv와 manifest.jsonl이 있는 디렉터리.
# 비워두면 Interpreter가 파일시스템에서 자동 탐색한다.
# CORPUS_DIR=data/corpus

# ─────────────────────────────────────────────────────────────────────────
# Retriever 모드: local
#   local - 제공 SQLite(chunk_index) + Chroma persistent HNSW 인덱스(read-only).
# ─────────────────────────────────────────────────────────────────────────
RETRIEVER_MODE=local

# local 모드 — 제공된 read-only 인덱스
RETRIEVER_INDEX_PATH=data/local_db/chunk_index.db
RETRIEVER_CHROMA_PATH=data/local_db/chunk_index_chroma
RETRIEVER_CHROMA_COLLECTION=chunk_vectors
RETRIEVER_SQL_TABLE=chunk_index
# e5 (유일한 운영값, fastembed / non-instruct — 인덱스를 만든 모델)
RETRIEVER_EMBEDDING=e5
RETRIEVER_ALLOW_PARTIAL_INDEX=true

# e5 임베딩 모델(ONNX) 캐시 위치. 컨테이너 이미지는 빌드 시 여기 미리 받아둔다.
# FASTEMBED_CACHE_DIR=/opt/models/fastembed

# ─────────────────────────────────────────────────────────────────────────
# CLOVA 답변 생성·semantic validation
# ─────────────────────────────────────────────────────────────────────────
CLOVA_LLM_ENABLED=true
CLOVA_CHAT_MODEL=HCX-005

# Interpreter unresolved 슬롯 보완. CLOVA_LLM_ENABLED와 독립적이다.
INTERPRETER_USE_LLM=1
CLOVA_INTERPRETER_MAX_TOKENS=1024
CLOVA_PLANNER_MAX_TOKENS=2048
CLOVA_FACT_MAX_TOKENS=1024

# Retriever production Reranker. 기본 OFF이며, 켤 때만 상위 100개를 전송한다.
CLOVA_RERANKER_ENABLED=false
CLOVA_RERANKER_CANDIDATE_LIMIT=100
CLOVA_RERANKER_TIMEOUT=60
CLOVA_RERANKER_MAX_RETRIES=1
CLOVA_RERANKER_MAX_TOKENS=1024

# CLOVA 호출·rate limit
CLOVA_CHAT_TIMEOUT=60
CLOVA_CHAT_MAX_RETRIES=1
CLOVA_CHAT_MIN_INTERVAL=0.2
CLOVA_RATE_LIMIT_MAX_WAIT=60
DIS164_QUERY_PLAN_V1=true
CLOVA_ANSWER_MAX_TOKENS=512
CLOVA_SEMANTIC_MAX_TOKENS=256
QUERY_PLANNER_LLM_ENABLED=1
