# Optional test-only integrations; not used by the Stage123 flow.
OPENAI_API_KEY=
TAVILY_API_KEY=
# CLOVA Studio
# All current integration clients use this Bearer API key.
CLOVA_API_KEY=
# Legacy package variable; callers pass CLOVA_API_KEY explicitly, so leave blank.
CLOVASTUDIO_API_KEY=
# Not used by the current integration code.
CLOVASTUDIO_APIGW_API_KEY=

# DB 경로(RDB/VectorDB)는 app/config.py에서 관리합니다.

# Stage123 integration
E2E_DB_BACKEND=json
LOCAL_JSON_DB_PATH=test_data/disclosure_clova_local.json
# 1이면 CLOVA embedding API로 JSON 저장 embedding을 검색합니다.
LOCAL_JSON_USE_CLOVA_EMBEDDING=1
STAGE1_USE_LLM=0
STAGE3_EXECUTION_MODE=stdlib
CLOVA_API_HOST=clovastudio.stream.ntruss.com

# Optional production DB path. JSON fixture mode above is the default.
# E2E_DB_BACKEND=production
# CORPUS_DIR=C:/path/to/corpus
